---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const SITE_TITLE = 'Your Scan Results | CC3PO';
const SITE_DESCRIPTION = 'Your website compliance, performance, and security scan results.';
const canonicalURL = new URL(Astro.url.pathname, 'https://audit.cc3po.com');
const ogImage = 'https://cc3po.com/wp-content/uploads/2026/04/Color-Logo-New.png';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="canonical" href={canonicalURL" />
		<meta property="og:title" content={SITE_TITLE} />
		<meta property="og:description" content={SITE_DESCRIPTION} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="CC3PO Audit" />
	</head>
	<body>
		<Header />
		
		<section class="results-page">
			<div id="scanResults" class="results-container"></div>
			<div id="noResults" class="no-results" style="display:none;">
				<h1>Scan Complete</h1>
				<p>Your results are being prepared. Check your email for the full report.</p>
				<a href="https://audit.cc3po.com" class="action-button primary">Scan Another Site</a>
			</div>
		</section>
		
		<Footer />

		<script is:inline>
		(function() {
			var params = new URLSearchParams(window.location.search);
			var scanData = sessionStorage.getItem('cc3po_scan_result');
			
			if (!scanData) {
				document.getElementById('noResults').style.display = 'flex';
				return;
			}

			var data = JSON.parse(scanData);
			var score = data.overallScore;
			var label = score >= 90 ? 'Excellent' : score >= 75 ? 'Good' : score >= 50 ? 'Needs Work' : 'At Risk';
			var color = score >= 90 ? '#2ed573' : score >= 75 ? '#7bed9f' : score >= 50 ? '#ffa502' : '#ff4757';
			
			var issues = data.issues || [];
			var criticalCount = issues.filter(function(i) { return i.severity === 'critical'; }).length;
			var warningCount = issues.filter(function(i) { return i.severity === 'warning'; }).length;
			
			var container = document.getElementById('scanResults');
			container.innerHTML = `
				<div class="score-hero">
					<div class="score-ring-container">
						<svg class="score-ring" width="180" height="180" viewBox="0 0 180 180">
							<circle class="ring-bg" cx="90" cy="90" r="78" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="10"/>
							<circle class="ring-progress" cx="90" cy="90" r="78" fill="none" stroke="${color}" stroke-width="10" stroke-linecap="round" stroke-dasharray="${2 * Math.PI * 78}" stroke-dashoffset="${2 * Math.PI * 78 - (score / 100) * 2 * Math.PI * 78}" transform="rotate(-90 90 90)"/>
						</svg>
						<div class="score-inner">
							<span class="score-value" style="color:${color}">${score}</span>
							<span class="score-label">${label}</span>
						</div>
					</div>
					<div class="score-info">
						<h1>Your Site <span class="gradient-text">${label === 'At Risk' || label === 'Needs Work' ? 'Needs Attention' : 'Looks Good'}</span></h1>
						<p class="score-url">${data.url}</p>
						<p class="score-summary">${criticalCount} critical · ${warningCount} warnings · ${issues.length} total issues found</p>
					</div>
				</div>

				<div class="categories-row">
					<div class="cat-card">
						<div class="cat-score" style="color:${getCatColor(data.compliance.score)}">${data.compliance.score}</div>
						<div class="cat-name">Compliance</div>
						<div class="cat-badge ${getCatBadge(data.compliance.score)}">${data.compliance.label}</div>
						<div class="cat-findings">${data.compliance.findings} finding${data.compliance.findings !== 1 ? 's' : ''}</div>
					</div>
					<div class="cat-card">
						<div class="cat-score" style="color:${getCatColor(data.performance.score)}">${data.performance.score}</div>
						<div class="cat-name">Performance</div>
						<div class="cat-badge ${getCatBadge(data.performance.score)}">${data.performance.label}</div>
						<div class="cat-findings">${data.performance.findings} finding${data.performance.findings !== 1 ? 's' : ''}</div>
					</div>
					<div class="cat-card">
						<div class="cat-score" style="color:${getCatColor(data.security.score)}">${data.security.score}</div>
						<div class="cat-name">Security</div>
						<div class="cat-badge ${getCatBadge(data.security.score)}">${data.security.label}</div>
						<div class="cat-findings">${data.security.findings} finding${data.security.findings !== 1 ? 's' : ''}</div>
					</div>
				</div>

				<div class="issues-section">
					<h2>Issues Found</h2>
					${issues.sort(function(a,b){ var o={critical:0,warning:1,info:2}; return o[a.severity]-o[b.severity]; }).map(function(issue) {
						var sevColor = issue.severity === 'critical' ? '#ff4757' : issue.severity === 'warning' ? '#ffa502' : '#3498db';
						var sevBg = issue.severity === 'critical' ? 'rgba(255,71,87,0.1)' : issue.severity === 'warning' ? 'rgba(255,165,2,0.1)' : 'rgba(52,152,219,0.1)';
						return '<div class="issue-card" style="border-left:3px solid ' + sevColor + '">' +
							'<div class="issue-header">' +
								'<span class="severity-badge" style="background:' + sevBg + ';color:' + sevColor + '">' + issue.severity + '</span>' +
								(issue.category ? '<span class="cat-tag">' + issue.category + '</span>' : '') +
								(issue.wcag ? '<span class="wcag-ref">' + issue.wcag + '</span>' : '') +
							'</div>' +
							'<h3>' + issue.title + '</h3>' +
							'<p>' + issue.description + '</p>' +
							'<div class="fix-tip"><strong>Fix:</strong> ' + issue.fix + '</div>' +
						'</div>';
					}).join('')}
				</div>

				<div class="cta-section">
					<h2>We Can Fix These For You</h2>
					<p>From $97/mo — compliance, speed, and security handled. So you can run your business.</p>
					<div class="cta-buttons">
						<a href="https://pricing.cc3po.com" class="action-button primary">See Plans</a>
						<a href="https://cc3po.com/contact" class="action-button secondary">Talk to Us</a>
					</div>
				</div>

				<div class="rescan-section">
					<a href="https://audit.cc3po.com" class="action-button outline">Scan Another Site →</a>
				</div>
			`;

			function getCatColor(s) { return s >= 90 ? '#2ed573' : s >= 75 ? '#7bed9f' : s >= 50 ? '#ffa502' : '#ff4757'; }
			function getCatBadge(s) { return s >= 90 ? 'badge-excellent' : s >= 75 ? 'badge-good' : s >= 50 ? 'badge-needs' : 'badge-risk'; }
		})();
		</script>

	<style>
		:root {
			--bg: #0a0a0b;
			--surface: rgba(255,255,255,0.03);
			--border: rgba(255,255,255,0.06);
			--text: #fafafa;
			--text-muted: #a1a1aa;
			--accent: #e94560;
			--accent-2: #4cc9f0;
		}
		* { margin: 0; padding: 0; box-sizing: border-box; }
		body { font-family: Inter, system-ui, sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; }
		.gradient-text { background: linear-gradient(135deg, #e94560, #4cc9f0); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
		
		.results-page { max-width: 800px; margin: 0 auto; padding: 120px 24px 60px; }
		.no-results { min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 20px; }
		.no-results h1 { font-size: 2rem; font-weight: 700; }
		.no-results p { color: var(--text-muted); }

		.score-hero { display: flex; align-items: center; gap: 40px; margin-bottom: 40px; flex-wrap: wrap; }
		.score-ring-container { position: relative; flex-shrink: 0; }
		.score-inner { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); text-align: center; }
		.score-value { font-size: 2.5rem; font-weight: 800; display: block; }
		.score-label { font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
		.score-info h1 { font-size: 1.8rem; font-weight: 700; margin-bottom: 8px; }
		.score-url { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 8px; }
		.score-summary { color: var(--text-muted); font-size: 0.85rem; }

		.categories-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; margin-bottom: 40px; }
		.cat-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px 16px; text-align: center; }
		.cat-score { font-size: 2.5rem; font-weight: 800; }
		.cat-name { font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin: 4px 0 12px; }
		.cat-badge { display: inline-block; padding: 4px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; }
		.badge-excellent { background: rgba(46,213,115,0.1); color: #2ed573; }
		.badge-good { background: rgba(123,237,159,0.1); color: #7bed9f; }
		.badge-needs { background: rgba(255,165,2,0.1); color: #ffa502; }
		.badge-risk { background: rgba(255,71,87,0.1); color: #ff4757; }
		.cat-findings { color: var(--text-muted); font-size: 0.75rem; margin-top: 8px; }

		.issues-section { margin-bottom: 40px; }
		.issues-section h2 { font-size: 1.3rem; font-weight: 700; margin-bottom: 16px; }
		.issue-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 12px; }
		.issue-header { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
		.severity-badge { padding: 2px 10px; border-radius: 4px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
		.cat-tag { padding: 2px 8px; border-radius: 4px; background: rgba(255,255,255,0.05); color: var(--text-muted); font-size: 0.7rem; text-transform: capitalize; }
		.wcag-ref { margin-left: auto; color: var(--text-muted); font-size: 0.7rem; }
		.issue-card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 6px; }
		.issue-card p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 12px; line-height: 1.5; }
		.fix-tip { background: rgba(0,212,170,0.06); border: 1px solid rgba(0,212,170,0.15); border-radius: 8px; padding: 12px 16px; font-size: 0.85rem; line-height: 1.5; }
		.fix-tip strong { color: #00d4aa; }

		.cta-section { background: var(--surface); border: 1px solid var(--accent); border-radius: 20px; padding: 40px; text-align: center; margin-bottom: 32px; }
		.cta-section h2 { font-size: 1.5rem; font-weight: 700; margin-bottom: 8px; }
		.cta-section p { color: var(--text-muted); margin-bottom: 24px; }
		.cta-buttons { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
		.rescan-section { text-align: center; padding: 20px 0; }
		
		.action-button { padding: 14px 28px; border-radius: 12px; font-size: 0.9rem; font-weight: 600; text-decoration: none; display: inline-block; transition: transform 0.2s, box-shadow 0.2s; }
		.action-button:hover { transform: translateY(-2px); }
		.action-button.primary { background: linear-gradient(135deg, #e94560, #7209b7); color: #fff; }
		.action-button.primary:hover { box-shadow: 0 8px 30px rgba(233,69,96,0.3); }
		.action-button.secondary { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; }
		.action-button.outline { background: transparent; border: 1px solid var(--border); color: var(--text-muted); }

		@media(max-width:640px) {
			.score-hero { flex-direction: column; text-align: center; }
			.categories-row { grid-template-columns: 1fr; }
			.cta-buttons { flex-direction: column; }
		}
	</style>
	</body>
</html>