<script is:inline>
(function() {
  // Form submission handler — captures URL + email, sends to API, then redirects
  function handleFormSubmit(form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      var urlInput = form.querySelector('input[name="url"]');
      var emailInput = form.querySelector('input[name="email"]');
      var tierInput = form.querySelector('input[name="tier"]');
      var submitBtn = form.querySelector('button[type="submit"]');
      var statusEl = document.getElementById('formStatus');
      
      var urlVal = urlInput ? urlInput.value.trim() : '';
      var emailVal = emailInput ? emailInput.value.trim() : '';
      var tierVal = tierInput ? tierInput.value : (form.dataset.tier || 'free');
      
      // Basic validation
      if (!urlVal) {
        urlInput.focus();
        if (statusEl) statusEl.textContent = 'Please enter a website URL.';
        return;
      }
      if (!emailVal) {
        emailInput.focus();
        if (statusEl) statusEl.textContent = 'Please enter your email.';
        return;
      }
      
      // Ensure URL has protocol
      if (!/^https?:\/\//i.test(urlVal)) {
        urlVal = 'https://' + urlVal;
      }
      
      // Disable button, show loading
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Calculating...';
      }
      if (statusEl) statusEl.textContent = 'Analyzing your business health...';
      
      // Send to our Netlify function
      fetch('/.netlify/functions/lead-notification', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          table: 'audit_requests',
          url: urlVal,
          website: urlVal,
          email: emailVal,
          name: '',
          lead_type: 'health_score',
          tier: tierVal,
          source: 'audit.cc3po.com',
          _subject: 'New Health Score Request: ' + urlVal
        })
      }).then(function(response) {
        if (response.ok) {
          window.location.href = '/success?url=' + encodeURIComponent(urlVal) + '&email=' + encodeURIComponent(emailVal);
        } else {
          window.location.href = '/success?url=' + encodeURIComponent(urlVal) + '&email=' + encodeURIComponent(emailVal);
        }
      }).catch(function() {
        window.location.href = '/success?url=' + encodeURIComponent(urlVal) + '&email=' + encodeURIComponent(emailVal);
      });
    });
  }
  
  // Attach to both forms
  var mainForm = document.getElementById('scanForm');
  var bottomForm = document.getElementById('scanFormBottom');
  if (mainForm) handleFormSubmit(mainForm);
  if (bottomForm) handleFormSubmit(bottomForm);
  
  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(function(a) {
    a.addEventListener('click', function(e) {
      var target = document.querySelector(this.getAttribute('href'));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
  
  // Pricing tier buttons sync tier to form
  document.querySelectorAll('a[onclick]').forEach(function(a) {
    a.addEventListener('click', function() {
      if (mainForm && mainForm.dataset.tier) {
        var tierField = mainForm.querySelector('input[name="tier"]');
        if (tierField) tierField.value = mainForm.dataset.tier;
      }
    });
  });
})();
</script>
	<script>
	(function() {
		var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		var observerOptions = { root: null, rootMargin: '0px 0px -60px 0px', threshold: 0.1 };
		var observer = new IntersectionObserver(function(entries) {
			entries.forEach(function(entry) {
				if (entry.isIntersecting) {
					entry.target.classList.add('visible');
					if (entry.target.hasAttribute('data-count')) { animateCounter(entry.target); }
					observer.unobserve(entry.target);
				}
			});
		}, observerOptions);
		document.querySelectorAll('.animate-on-scroll').forEach(function(el) {
			if (prefersReducedMotion) { el.classList.add('visible'); } else { observer.observe(el); }
		});
		function animateCounter(el) {
			var target = parseInt(el.getAttribute('data-count'), 10);
			var suffix = el.getAttribute('data-suffix') || '';
			var prefix = el.getAttribute('data-prefix') || '';
			var duration = parseInt(el.getAttribute('data-duration') || '2000', 10);
			var startTime = performance.now();
			function update(currentTime) {
				var elapsed = currentTime - startTime;
				var progress = Math.min(elapsed / duration, 1);
				var eased = 1 - Math.pow(1 - progress, 3);
				var current = Math.floor(target * eased);
				el.textContent = prefix + current.toLocaleString() + suffix;
				if (progress < 1) { requestAnimationFrame(update); }
				else { el.textContent = prefix + target.toLocaleString() + suffix; }
			}
			requestAnimationFrame(update);
		}
		document.querySelectorAll('[data-count]').forEach(function(el) {
			if (!el.classList.contains('animate-on-scroll')) { el.classList.add('animate-on-scroll'); observer.observe(el); }
		});
		var nav = document.querySelector('nav');
		if (nav) {
			window.addEventListener('scroll', function() {
				if (window.scrollY > 20) { nav.classList.add('scrolled'); }
				else { nav.classList.remove('scrolled'); }
			}, { passive: true });
		}
	})();
	</script>
