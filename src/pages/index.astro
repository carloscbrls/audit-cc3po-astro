---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const SITE_TITLE = 'Free WCAG Accessibility Audit | CC3PO — Is Your Website ADA Compliant?';
const SITE_DESCRIPTION = 'Find out if your website meets WCAG 2.1 AA standards. Free instant scan reveals top accessibility violations. Full reports and monthly monitoring available.';
const canonicalURL = new URL(Astro.url.pathname, 'https://audit.cc3po.com');
const ogImage = 'https://cc3po.com/wp-content/uploads/2026/04/Color-Logo-New.png';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:title" content={SITE_TITLE} />
		<meta property="og:description" content={SITE_DESCRIPTION} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="CC3PO Accessibility Audit" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={SITE_TITLE} />
		<meta name="twitter:description" content={SITE_DESCRIPTION} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Accessibility Audit Service Schema -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Service",
			"serviceType": "WCAG Accessibility Audit",
			"provider": {
				"@type": "LocalBusiness",
				"name": "CC3PO",
				"telephone": "+1-209-423-6633",
				"email": "info@cc3po.com",
				"url": "https://audit.cc3po.com",
				"address": {
					"@type": "PostalAddress",
					"addressLocality": "Stockton",
					"addressRegion": "CA",
					"addressCountry": "US"
				},
				"priceRange": "$0 - $297"
			},
			"areaServed": "US",
			"hasOfferCatalog": {
				"@type": "OfferCatalog",
				"name": "Accessibility Audit Services",
				"itemListElement": [
					{
						"@type": "Offer",
						"name": "Free Scan",
						"price": "0",
						"priceCurrency": "USD",
						"description": "Instant automated WCAG 2.1 AA audit showing top 3 issues"
					},
					{
						"@type": "Offer",
						"name": "Full Report",
						"price": "297",
						"priceCurrency": "USD",
						"description": "Complete WCAG audit with PDF report and fix recommendations"
					},
					{
						"@type": "Offer",
						"name": "Monthly Monitoring",
						"price": "97",
						"priceCurrency": "USD",
						"description": "Weekly scans with alerts when new violations appear"
					}
				]
			}
		})} />
	</head>
	<body>
		<Header />

		<!-- Hero Section -->
		<section class="hero" id="audit-form">
			<div class="container">
				<div class="hero-content">
					<div class="hero-badge">FREE ACCESSIBILITY SCAN</div>
					<h1>Is Your Website <span class="highlight">ADA Compliant?</span></h1>
					<p class="hero-sub">Find out in 30 seconds. Our automated WCAG 2.1 AA audit reveals accessibility violations that could cost you $50K+ per lawsuit.</p>
					<div class="hero-stats">
						<div class="stat">
							<span class="stat-number">96%</span>
							<span class="stat-label">of websites have WCAG violations</span>
						</div>
						<div class="stat">
							<span class="stat-number">$50K+</span>
							<span class="stat-label">average ADA lawsuit cost</span>
						</div>
						<div class="stat">
							<span class="stat-number">4,000+</span>
							<span class="stat-label">ADA lawsuits filed per year</span>
						</div>
					</div>
					<form class="scan-form" id="scanForm" action="/success" method="GET" data-tier="free">
						<div class="form-row">
							<input type="url" name="url" placeholder="Enter your website URL (e.g., https://yoursite.com)" required aria-label="Website URL to audit" />
							<input type="email" name="email" placeholder="Your email (for results)" required aria-label="Email address for audit results" />
							<button type="submit" class="btn-primary">Get Your Free Scan →</button>
						</div>
						<p class="form-note">No credit card required. Results delivered to your inbox in minutes.</p>
					</form>
				</div>
			</div>
		</section>

		<!-- What We Scan -->
		<section class="scan-details" id="what-we-check">
			<div class="container">
				<h2>What Our <span class="highlight">WCAG 2.1 AA</span> Audit Covers</h2>
				<p class="section-sub">Our automated scanner checks your website against 50+ WCAG 2.1 AA success criteria using axe-core, the industry-standard accessibility engine.</p>
				<div class="scan-grid">
					<div class="scan-card">
						<div class="scan-icon">🎨</div>
						<h3>Color Contrast</h3>
						<p>Text must have sufficient contrast against backgrounds. We check all foreground/background color combinations against WCAG ratios (4.5:1 for normal text, 3:1 for large text).</p>
					</div>
					<div class="scan-card">
						<div class="scan-icon">🏷️</div>
						<h3>Form Labels</h3>
						<p>Every form input needs an associated label. Missing labels mean screen readers can't tell users what to enter — and it's the #1 WCAG violation we find.</p>
					</div>
					<div class="scan-card">
						<div class="scan-icon">♿</div>
						<h3>ARIA Attributes</h3>
						<p>Incorrect or missing ARIA roles, labels, and states break assistive technology. We validate ARIA usage against WAI-ARIA specifications.</p>
					</div>
					<div class="scan-card">
						<div class="scan-icon">🧭</div>
						<h3>Navigation</h3>
						<p>Keyboard navigation, skip links, focus management, and consistent page structure. Can users navigate your site without a mouse?</p>
					</div>
					<div class="scan-card">
						<div class="scan-icon">🖼️</div>
						<h3>Alt Text & Images</h3>
						<p>Every image needs descriptive alt text. Decorative images need empty alt attributes. We check them all and flag missing or unhelpful alt text.</p>
					</div>
					<div class="scan-card">
						<div class="scan-icon">📝</div>
						<h3>Semantic HTML</h3>
						<p>Proper heading hierarchy, landmark regions, list structures, and data tables. Semantic HTML is the foundation of accessible websites.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Why It Matters -->
		<section class="why-matters">
			<div class="container">
				<h2>Why Accessibility <span class="highlight">Compliance Matters</span></h2>
				<div class="matters-grid">
					<div class="matters-card">
						<div class="matters-icon">⚖️</div>
						<h3>Legal Protection</h3>
						<p>ADA Title III lawsuits targeting websites have increased 300% since 2018. Average settlement: $50K. Being proactive costs a fraction of being sued.</p>
					</div>
					<div class="matters-card">
						<div class="matters-icon">👥</div>
						<h3>1.3 Billion Customers</h3>
						<p>15% of the global population lives with a disability. Accessible websites reach more customers and increase revenue by up to 28%.</p>
					</div>
					<div class="matters-card">
						<div class="matters-icon">🔍</div>
						<h3>SEO Benefits</h3>
						<p>Google rewards accessible websites. Proper alt text, semantic HTML, and fast, usable pages all contribute to better search rankings.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Pricing -->
		<section class="pricing" id="pricing">
			<div class="container">
				<h2>Choose Your <span class="highlight">Audit Level</span></h2>
				<p class="section-sub">From a quick checkup to ongoing compliance monitoring — we've got you covered.</p>
				<div class="pricing-grid">
					<div class="pricing-card">
						<div class="pricing-badge">STARTER</div>
						<div class="pricing-price">$0</div>
						<div class="pricing-label">Free Scan</div>
						<ul class="pricing-features">
							<li>✓ Instant automated audit</li>
							<li>✓ Top 3 violations identified</li>
							<li>✓ Severity level for each issue</li>
							<li>✓ WCAG guideline references</li>
							<li class="muted">✗ Detailed fix recommendations</li>
							<li class="muted">✗ PDF report</li>
							<li class="muted">✗ Ongoing monitoring</li>
						</ul>
						<a href="#audit-form" class="btn-secondary" onclick="document.getElementById('scanForm').dataset.tier='free'">Start Free Scan</a>
					</div>
					<div class="pricing-card featured">
						<div class="pricing-badge">POPULAR</div>
						<div class="pricing-price">$297</div>
						<div class="pricing-label">Full Report</div>
						<ul class="pricing-features">
							<li>✓ Complete WCAG 2.1 AA audit</li>
							<li>✓ All violations + affected elements</li>
							<li>✓ PDF report with branding</li>
							<li>✓ Detailed fix recommendations</li>
							<li>✓ WCAG guideline links</li>
							<li>✓ Priority severity ranking</li>
							<li class="muted">✗ Ongoing monitoring</li>
						</ul>
						<a href="#audit-form" class="btn-primary" onclick="document.getElementById('scanForm').dataset.tier='full'">Get Full Report</a>
					</div>
					<div class="pricing-card">
						<div class="pricing-badge">ONGOING</div>
						<div class="pricing-price">$97<span class="pricing-period">/mo</span></div>
						<div class="pricing-label">Monthly Monitoring</div>
						<ul class="pricing-features">
							<li>✓ Weekly automated scans</li>
							<li>✓ Instant alerts on new violations</li>
							<li>✓ Full PDF reports each scan</li>
							<li>✓ Fix recommendations included</li>
							<li>✓ Compliance trend tracking</li>
							<li>✓ Email + dashboard access</li>
							<li>✓ Priority support</li>
						</ul>
						<a href="#audit-form" class="btn-secondary" onclick="document.getElementById('scanForm').dataset.tier='monitoring'">Start Monitoring</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Social Proof -->
		<section class="social-proof">
			<div class="container">
				<div class="proof-stats">
					<div class="proof-stat">
						<span class="proof-number">500+</span>
						<span class="proof-label">Websites Audited</span>
					</div>
					<div class="proof-stat">
						<span class="proof-number">5+</span>
						<span class="proof-label">Average Violations Found</span>
					</div>
					<div class="proof-stat">
						<span class="proof-number">98%</span>
						<span class="proof-label">Client Satisfaction</span>
					</div>
				</div>
				<div class="testimonials">
					<div class="testimonial">
						<p>"CC3PO found 12 WCAG violations on our site that our previous auditor missed completely. The fix recommendations were clear and actionable."</p>
						<span class="testimonial-author">— Sarah M., Marketing Director</span>
					</div>
					<div class="testimonial">
						<p>"We were facing an ADA lawsuit threat. The full report gave us everything we needed to remediate quickly and demonstrate good faith compliance."</p>
						<span class="testimonial-author">— David R., Business Owner</span>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="cta">
			<div class="container">
				<h2>Don't Wait for a Lawsuit Letter</h2>
				<p>Find out where your website stands — for free. Your 30-second scan could save you $50,000+ in legal costs.</p>
				<form class="scan-form scan-form-center" action="/success" method="GET">
					<input type="hidden" name="tier" value="free" />
					<div class="form-row">
						<input type="url" name="url" placeholder="Enter your website URL" required aria-label="Website URL" />
						<input type="email" name="email" placeholder="Your email" required aria-label="Email address" />
						<button type="submit" class="btn-primary">Get Your Free Scan →</button>
					</div>
				</form>
			</div>
		</section>

		<Footer />

		<style>
			/* --- Base --- */
			:root {
				--blue-600: #1a56db;
				--blue-500: #2563eb;
				--blue-400: #3b82f6;
				--blue-100: #dbeafe;
				--blue-50: #eff6ff;
				--navy-900: #0f172a;
				--navy-800: #1e293b;
				--navy-700: #334155;
				--gray-600: #475569;
				--gray-400: #94a3b8;
				--gray-200: #e2e8f0;
				--gray-100: #f1f5f9;
				--white: #ffffff;
				--red-500: #ef4444;
				--green-500: #22c55e;
				--amber-500: #f59e0b;
			}

			* { margin: 0; padding: 0; box-sizing: border-box; }

			html { scroll-behavior: smooth; }

			body {
				font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
				color: var(--navy-900);
				background: var(--white);
				line-height: 1.6;
			}

			.container {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0 24px;
			}

			.highlight { color: var(--blue-600); }

			/* --- Hero --- */
			.hero {
				background: linear-gradient(135deg, rgba(10,10,18,0.92) 0%, rgba(17,17,31,0.88) 100%), url('/images/heroes/cc3po-hero-audit.png') center/cover no-repeat;
				color: var(--white);
				padding: 100px 0 80px;
				min-height: 70vh;
				display: flex;
				align-items: center;
			}

			.hero-badge {
				display: inline-block;
				background: rgba(59, 130, 246, 0.2);
				color: var(--blue-400);
				padding: 6px 16px;
				border-radius: 20px;
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				margin-bottom: 24px;
			}

			.hero h1 {
				font-size: clamp(2.2rem, 5vw, 3.5rem);
				font-weight: 800;
				line-height: 1.15;
				margin-bottom: 20px;
			}

			.hero-sub {
				font-size: 1.2rem;
				color: var(--gray-400);
				max-width: 640px;
				margin-bottom: 40px;
			}

			.hero-stats {
				display: flex;
				gap: 40px;
				margin-bottom: 48px;
				flex-wrap: wrap;
			}

			.stat { display: flex; flex-direction: column; }

			.stat-number {
				font-size: 2rem;
				font-weight: 800;
				color: var(--blue-400);
			}

			.stat-label {
				font-size: 0.85rem;
				color: var(--gray-400);
			}

			/* --- Form --- */
			.scan-form {
				max-width: 720px;
			}

			.scan-form-center {
				margin: 0 auto;
			}

			.form-row {
				display: flex;
				gap: 12px;
				flex-wrap: wrap;
			}

			.form-row input {
				flex: 1;
				min-width: 200px;
				padding: 14px 18px;
				border: 2px solid var(--gray-200);
				border-radius: 10px;
				font-size: 1rem;
				font-family: inherit;
				outline: none;
				transition: border-color 0.2s;
			}

			.form-row input:focus {
				border-color: var(--blue-500);
			}

			.btn-primary {
				padding: 14px 32px;
				background: var(--blue-600);
				color: var(--white);
				border: none;
				border-radius: 10px;
				font-size: 1rem;
				font-weight: 700;
				cursor: pointer;
				white-space: nowrap;
				transition: background 0.2s;
			}

			.btn-primary:hover { background: var(--blue-500); }

			.btn-secondary {
				padding: 14px 32px;
				background: var(--white);
				color: var(--blue-600);
				border: 2px solid var(--blue-600);
				border-radius: 10px;
				font-size: 1rem;
				font-weight: 700;
				cursor: pointer;
				transition: all 0.2s;
			}

			.btn-secondary:hover {
				background: var(--blue-600);
				color: var(--white);
			}

			.form-note {
				margin-top: 12px;
				font-size: 0.85rem;
				color: var(--gray-400);
			}

			/* --- Scan Details --- */
			.scan-details {
				padding: 80px 0;
				background: var(--gray-100);
			}

			.scan-details h2 {
				font-size: 2rem;
				font-weight: 800;
				text-align: center;
				margin-bottom: 12px;
			}

			.section-sub {
				text-align: center;
				color: var(--gray-600);
				max-width: 600px;
				margin: 0 auto 48px;
				font-size: 1.05rem;
			}

			.scan-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 24px;
			}

			.scan-card {
				background: var(--white);
				padding: 32px;
				border-radius: 12px;
				border: 1px solid var(--gray-200);
			}

			.scan-icon { font-size: 2rem; margin-bottom: 12px; }

			.scan-card h3 {
				font-size: 1.15rem;
				font-weight: 700;
				margin-bottom: 8px;
			}

			.scan-card p {
				color: var(--gray-600);
				font-size: 0.95rem;
			}

			/* --- Why It Matters --- */
			.why-matters {
				padding: 80px 0;
			}

			.why-matters h2 {
				font-size: 2rem;
				font-weight: 800;
				text-align: center;
				margin-bottom: 48px;
			}

			.matters-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 32px;
			}

			.matters-card {
				text-align: center;
				padding: 40px 24px;
			}

			.matters-icon { font-size: 2.5rem; margin-bottom: 16px; }

			.matters-card h3 {
				font-size: 1.2rem;
				font-weight: 700;
				margin-bottom: 12px;
			}

			.matters-card p {
				color: var(--gray-600);
				font-size: 0.95rem;
			}

			/* --- Pricing --- */
			.pricing {
				padding: 80px 0;
				background: var(--gray-100);
			}

			.pricing h2 {
				font-size: 2rem;
				font-weight: 800;
				text-align: center;
				margin-bottom: 12px;
			}

			.pricing-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 24px;
				max-width: 960px;
				margin: 0 auto;
			}

			.pricing-card {
				background: var(--white);
				padding: 36px 28px;
				border-radius: 16px;
				border: 2px solid var(--gray-200);
				text-align: center;
			}

			.pricing-card.featured {
				border-color: var(--blue-600);
				box-shadow: 0 8px 30px rgba(37, 99, 235, 0.15);
				transform: scale(1.03);
			}

			.pricing-badge {
				display: inline-block;
				background: var(--blue-100);
				color: var(--blue-600);
				padding: 4px 14px;
				border-radius: 12px;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				margin-bottom: 20px;
			}

			.pricing-card.featured .pricing-badge {
				background: var(--blue-600);
				color: var(--white);
			}

			.pricing-price {
				font-size: 3rem;
				font-weight: 800;
				color: var(--navy-900);
			}

			.pricing-period {
				font-size: 1rem;
				font-weight: 500;
				color: var(--gray-600);
			}

			.pricing-label {
				font-size: 1.05rem;
				color: var(--gray-600);
				margin-bottom: 24px;
				font-weight: 600;
			}

			.pricing-features {
				list-style: none;
				text-align: left;
				margin-bottom: 28px;
			}

			.pricing-features li {
				padding: 8px 0;
				font-size: 0.95rem;
				border-bottom: 1px solid var(--gray-100);
			}

			.pricing-features li.muted {
				color: var(--gray-400);
			}

			.pricing-card > a.btn-primary,
			.pricing-card > a.btn-secondary {
				display: block;
				width: 100%;
				text-align: center;
				text-decoration: none;
				margin-top: auto;
				padding: 14px 32px;
				border-radius: 10px;
				font-size: 1rem;
				font-weight: 700;
				cursor: pointer;
				transition: background 0.2s, transform 0.15s;
			}
			.pricing-card > a.btn-primary {
				background: var(--blue-600);
				color: var(--white);
				border: none;
			}
			.pricing-card > a.btn-primary:hover {
				background: var(--blue-500);
			}
			.pricing-card > a.btn-secondary {
				background: var(--white);
				color: var(--blue-600);
				border: 2px solid var(--blue-600);
			}
			.pricing-card > a.btn-secondary:hover {
				background: var(--blue-600);
				color: var(--white);
			}

			/* --- Social Proof --- */
			.social-proof {
				padding: 80px 0;
			}

			.proof-stats {
				display: flex;
				justify-content: center;
				gap: 60px;
				margin-bottom: 60px;
				flex-wrap: wrap;
			}

			.proof-stat {
				text-align: center;
			}

			.proof-number {
				display: block;
				font-size: 2.5rem;
				font-weight: 800;
				color: var(--blue-600);
			}

			.proof-label {
				font-size: 0.9rem;
				color: var(--gray-600);
			}

			.testimonials {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
				gap: 32px;
				max-width: 900px;
				margin: 0 auto;
			}

			.testimonial {
				background: var(--gray-100);
				padding: 32px;
				border-radius: 12px;
				border-left: 4px solid var(--blue-500);
			}

			.testimonial p {
				font-size: 1.05rem;
				margin-bottom: 16px;
				font-style: italic;
			}

			.testimonial-author {
				font-size: 0.9rem;
				color: var(--gray-600);
				font-weight: 600;
			}

			/* --- CTA --- */
			.cta {
				padding: 80px 0;
				background: linear-gradient(135deg, var(--navy-900) 0%, var(--navy-800) 100%);
				color: var(--white);
				text-align: center;
			}

			.cta h2 {
				font-size: 2rem;
