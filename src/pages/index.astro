---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const SITE_TITLE = 'Free Business Health Score | CC3PO — While You Sleep, Your Business Doesn\'t';
const SITE_DESCRIPTION = 'Get your free Business Health Score in 30 seconds. See what\'s working, what\'s broken, and what your team would fix. Website monitoring, reviews, social media, compliance — all handled.';
const canonicalURL = new URL(Astro.url.pathname, 'https://audit.cc3po.com');
const ogImage = 'https://cc3po.com/wp-content/uploads/2026/04/Color-Logo-New.png';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:title" content={SITE_TITLE} />
		<meta property="og:description" content={SITE_DESCRIPTION} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="CC3PO Business Health Score" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={SITE_TITLE} />
		<meta name="twitter:description" content={SITE_DESCRIPTION} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Business Health Score Service Schema -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Service",
			"serviceType": "Business Health Score & Automated Business Management",
			"provider": {
				"@type": "LocalBusiness",
				"name": "CC3PO",
				"telephone": "+1-209-423-6633",
				"email": "info@cc3po.com",
				"url": "https://audit.cc3po.com",
				"address": {
					"@type": "PostalAddress",
					"addressLocality": "Stockton",
					"addressRegion": "CA",
					"addressCountry": "US"
				},
				"priceRange": "$0 - $1,297"
			},
			"areaServed": "US",
			"hasOfferCatalog": {
				"@type": "OfferCatalog",
				"name": "Business Health Score Services",
				"itemListElement": [
					{
						"@type": "Offer",
						"name": "Free Business Health Score",
						"price": "0",
						"priceCurrency": "USD",
						"description": "Instant health score (0-100), top 3 issues, industry comparison, and fix recommendations"
					},
					{
						"@type": "Offer",
						"name": "Growth Plan",
						"price": "497",
						"priceCurrency": "USD",
						"description": "Website guardian, review responder, social media, compliance officer, and business analyst — monthly"
					},
					{
						"@type": "Offer",
						"name": "Full Partnership",
						"price": "1297",
						"priceCurrency": "USD",
						"description": "Everything in Growth plus SEO, competitor monitoring, content creation, lead generation, and dedicated account contact — monthly"
					}
				]
			}
		})} />
	</head>
	<body>
		<Header />

		<style>
			@keyframes fadeInUp {
				from { opacity: 0; transform: translateY(30px); }
				to { opacity: 1; transform: translateY(0); }
			}
			@keyframes countUp {
				from { opacity: 0; transform: scale(0.5); }
				to { opacity: 1; transform: scale(1); }
			}
			@keyframes pulseGlow {
				0%, 100% { box-shadow: 0 0 20px rgba(233, 69, 96, 0.2); }
				50% { box-shadow: 0 0 40px rgba(233, 69, 96, 0.4); }
			}
			@keyframes slideInLeft {
				from { opacity: 0; transform: translateX(-40px); }
				to { opacity: 1; transform: translateX(0); }
			}
			@keyframes slideInRight {
				from { opacity: 0; transform: translateX(40px); }
				to { opacity: 1; transform: translateX(0); }
			}
			.animate-on-scroll {
				opacity: 0;
				transform: translateY(30px);
				transition: opacity 0.6s ease, transform 0.6s ease;
			}
			.animate-on-scroll.visible {
				opacity: 1;
				transform: translateY(0);
			}
			.animate-on-scroll.delay-1 { transition-delay: 0.1s; }
			.animate-on-scroll.delay-2 { transition-delay: 0.2s; }
			.animate-on-scroll.delay-3 { transition-delay: 0.3s; }
			.animate-on-scroll.delay-4 { transition-delay: 0.4s; }
			.animate-on-scroll.delay-5 { transition-delay: 0.5s; }
			.hover-lift {
				transition: transform 0.25s ease, box-shadow 0.25s ease;
			}
			.hover-lift:hover {
				transform: translateY(-4px);
				box-shadow: 0 8px 30px rgba(37, 99, 235, 0.15);
			}
			@media (prefers-reduced-motion: reduce) {
				.animate-on-scroll { opacity: 1; transform: none; transition: none; }
			}
		</style>

		<!-- Hero Section -->
		<section class="hero" id="audit-form">
			<video class="hero-video" autoplay loop muted playsinline>
				<source src="/videos/hero-scan.webm" type="video/webm">
				<source src="/videos/hero-scan.mp4" type="video/mp4">
			</video>
			<div class="container">
				<div class="hero-content">
					<div class="hero-badge">FREE BUSINESS HEALTH SCORE</div>
					<h1>While you sleep, <span class="highlight">your business doesn't.</span></h1>
					<p class="hero-sub">Get your free Business Health Score. See what's working, what's broken, and what your team would fix — in 30 seconds.</p>
					<div class="hero-stats">
						<div class="stat animate-on-scroll">
							<span class="stat-number" data-count="87" data-suffix="/100">87/100</span>
							<span class="stat-label">average health score after 3 months</span>
						</div>
						<div class="stat animate-on-scroll delay-1">
							<span class="stat-number" data-count="14" data-suffix=" pts">14 pts</span>
							<span class="stat-label">average improvement in month one</span>
						</div>
						<div class="stat animate-on-scroll delay-2">
							<span class="stat-number" data-count="3" data-suffix="/week">3/week</span>
							<span class="stat-label">issues found and fixed automatically</span>
						</div>
					</div>
					<form class="scan-form" id="scanForm" data-tier="free">
						<input type="hidden" name="tier" value="free" />
						<div class="form-row">
							<input type="url" name="url" id="urlInput" placeholder="Enter your website URL (e.g., https://yoursite.com)" required aria-label="Website URL to audit" />
							<input type="email" name="email" id="emailInput" placeholder="Your email (for results)" required aria-label="Email address for audit results" />
							<button type="submit" class="btn-primary">Get Your Free Score →</button>
						</div>
						<p class="form-note" id="formStatus">No credit card required. Your score in 30 seconds.</p>
					</form>
				</div>
			</div>
		</section>

		<!-- Morning Report Section -->
		<section class="morning-report">
			<div class="container">
				<h2 class="section-title animate-on-scroll">Your <span class="highlight">Morning Report</span></h2>
				<p class="section-sub animate-on-scroll">This is what a CC3PO customer wakes up to.</p>
				<div class="dashboard-card animate-on-scroll delay-1">
					<div class="dashboard-header">
						<div class="dashboard-greeting">
							<span class="dashboard-icon">☀️</span>
							<div>
								<div class="dashboard-greeting-text">Good morning.</div>
								<div class="dashboard-greeting-sub">Your business ran great overnight.</div>
							</div>
						</div>
						<div class="dashboard-date">Monday, May 12</div>
					</div>
					<div class="dashboard-items">
						<div class="dashboard-item">
							<span class="dashboard-check">✅</span>
							<div class="dashboard-item-content">
								<span class="dashboard-item-label">Website</span>
								<span class="dashboard-item-detail">Plugin conflict fixed at 2:14 AM</span>
							</div>
						</div>
						<div class="dashboard-item">
							<span class="dashboard-check">✅</span>
							<div class="dashboard-item-content">
								<span class="dashboard-item-label">Reviews</span>
								<span class="dashboard-item-detail">3 responded to professionally</span>
							</div>
						</div>
						<div class="dashboard-item">
							<span class="dashboard-check">✅</span>
							<div class="dashboard-item-content">
								<span class="dashboard-item-label">Social</span>
								<span class="dashboard-item-detail">2 posts published automatically</span>
							</div>
						</div>
						<div class="dashboard-item">
							<span class="dashboard-check">✅</span>
							<div class="dashboard-item-content">
								<span class="dashboard-item-label">Compliance</span>
								<span class="dashboard-item-detail">Up to date — new law already handled</span>
							</div>
						</div>
						<div class="dashboard-item">
							<span class="dashboard-check">✅</span>
							<div class="dashboard-item-content">
								<span class="dashboard-item-label">Competitor</span>
								<span class="dashboard-item-detail">Price drop detected — recommendation ready</span>
							</div>
						</div>
					</div>
					<div class="dashboard-score">
						<div class="dashboard-score-left">
							<span class="dashboard-score-label">Your business health score</span>
						</div>
						<div class="dashboard-score-right">
							<span class="dashboard-score-number">87<span class="dashboard-score-max">/100</span></span>
							<span class="dashboard-score-change">↑14 from last month</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Before/After Section -->
		<section class="before-after">
			<div class="container">
				<h2 class="section-title animate-on-scroll">Your Business <span class="highlight">With & Without</span></h2>
				<p class="section-sub animate-on-scroll">Same business. Different morning.</p>
				<div class="comparison-grid">
					<div class="comparison-card comparison-without animate-on-scroll delay-1">
						<div class="comparison-header">
							<span class="comparison-emoji">😰</span>
							<h3>Without CC3PO</h3>
						</div>
						<ul class="comparison-list">
							<li class="comparison-negative">⚠️ Website might be down — you'll find out from an angry customer</li>
							<li class="comparison-negative">⚠️ 3 bad reviews from the weekend — still unanswered</li>
							<li class="comparison-negative">⚠️ Should post on social media — forgotten again</li>
							<li class="comparison-negative">⚠️ New accessibility law? Don't have time to figure that out</li>
							<li class="comparison-negative">💤 11 PM still checking reviews instead of sleeping</li>
						</ul>
					</div>
					<div class="comparison-card comparison-with animate-on-scroll delay-2">
						<div class="comparison-header">
							<span class="comparison-emoji">😊</span>
							<h3>With CC3PO</h3>
						</div>
						<ul class="comparison-list">
							<li class="comparison-positive">✅ Website: fixed a problem at 2 AM while you slept</li>
							<li class="comparison-positive">✅ Reviews: 3 responded to in 30 minutes</li>
							<li class="comparison-positive">✅ Social: 2 posts went out automatically</li>
							<li class="comparison-positive">✅ New law: already compliant</li>
							<li class="comparison-positive">💤 Sleep great — your business runs itself</li>
						</ul>
					</div>
				</div>
				<div class="comparison-savings animate-on-scroll delay-3">
					<h3>What CC3PO replaces</h3>
					<div class="savings-grid">
						<div class="savings-item">
							<span class="savings-role">Web developer</span>
							<span class="savings-cost">$5,000/mo</span>
						</div>
						<div class="savings-item">
							<span class="savings-role">Social media manager</span>
							<span class="savings-cost">$3,000/mo</span>
						</div>
						<div class="savings-item">
							<span class="savings-role">Compliance consultant</span>
							<span class="savings-cost">$2,000/mo</span>
						</div>
						<div class="savings-item">
							<span class="savings-role">Review manager</span>
							<span class="savings-cost">$1,500/mo</span>
						</div>
						<div class="savings-item">
							<span class="savings-role">SEO specialist</span>
							<span class="savings-cost">$2,500/mo</span>
						</div>
						<div class="savings-total">
							<span class="savings-role">Traditional cost</span>
							<span class="savings-cost">$14,000/mo</span>
						</div>
						<div class="savings-cc3po">
							<span class="savings-role">CC3PO Growth</span>
							<span class="savings-cost">$497/mo</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- What We Scan (Role-Based) -->
		<section class="scan-details" id="what-we-check">
			<div class="container">
				<h2>Your <span class="highlight">Business Health Team</span></h2>
				<p class="section-sub animate-on-scroll">Six roles working 24/7 — so you don't have to.</p>
				<div class="scan-grid">
					<div class="scan-card animate-on-scroll hover-lift delay-1">
						<div class="scan-icon">🛡️</div>
						<h3>Your Website Guardian</h3>
						<p>Monitors your site 24/7. Fixes problems before you know they're broken. Plugin conflicts, uptime issues, speed drops — all handled automatically.</p>
					</div>
					<div class="scan-card animate-on-scroll hover-lift delay-2">
						<div class="scan-icon">✅</div>
						<h3>Your Compliance Officer</h3>
						<p>Keeps you legal and accessible. Always up to date with new laws. ADA, WCAG, state regulations — never caught off guard.</p>
					</div>
					<div class="scan-card animate-on-scroll hover-lift delay-3">
						<div class="scan-icon">📝</div>
						<h3>Your Content Creator</h3>
						<p>Blog posts, social media, emails. Created and published for you. Consistent content without lifting a finger.</p>
					</div>
					<div class="scan-card animate-on-scroll hover-lift delay-4">
						<div class="scan-icon">💬</div>
						<h3>Your Review Responder</h3>
						<p>Every review answered professionally within 30 minutes. Google, Yelp, Facebook — all platforms covered.</p>
					</div>
					<div class="scan-card animate-on-scroll hover-lift delay-5">
						<div class="scan-icon">🔍</div>
						<h3>Your Research Team</h3>
						<p>Watches competitors, finds opportunities, spots trends before they matter. You get recommendations, not data dumps.</p>
					</div>
					<div class="scan-card animate-on-scroll hover-lift delay-1">
						<div class="scan-icon">📊</div>
						<h3>Your Business Analyst</h3>
						<p>Tracks your health score, measures growth, recommends next steps. Clear numbers, not confusing reports.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Pricing -->
		<section class="pricing" id="pricing">
			<div class="container">
				<h2>Choose Your <span class="highlight">Business Health Plan</span></h2>
				<p class="section-sub animate-on-scroll">From a quick checkup to a team that runs your business while you sleep.</p>
				<div class="pricing-grid">
					<div class="pricing-card animate-on-scroll hover-lift delay-1">
						<div class="pricing-badge">FREE</div>
						<div class="pricing-price">$0</div>
						<div class="pricing-label">Business Health Score</div>
						<ul class="pricing-features">
							<li>✓ Instant health score (0–100)</li>
							<li>✓ Top 3 issues found</li>
							<li>✓ Industry comparison</li>
							<li>✓ "What we'd fix" recommendations</li>
							<li class="muted">✗ 24/7 monitoring</li>
							<li class="muted">✗ Review management</li>
							<li class="muted">✗ Content creation</li>
						</ul>
						<a href="#audit-form" class="btn-secondary" onclick="document.getElementById('scanForm').dataset.tier='free'">Get Your Free Score</a>
					</div>
					<div class="pricing-card featured animate-on-scroll hover-lift delay-2">
						<div class="pricing-badge">GROWTH</div>
						<div class="pricing-price">$497<span class="pricing-period">/mo</span></div>
						<div class="pricing-label">Full Business Health</div>
						<ul class="pricing-features">
							<li>✓ Everything in Free</li>
							<li>✓ Website guardian (24/7 monitoring + auto-fix)</li>
							<li>✓ Review responder (all platforms)</li>
							<li>✓ Social media (daily posts)</li>
							<li>✓ Compliance officer (always up to date)</li>
							<li>✓ Business analyst (monthly reports)</li>
							<li class="muted">✗ SEO & competitor monitoring</li>
						</ul>
						<a href="#audit-form" class="btn-primary" onclick="document.getElementById('scanForm').dataset.tier='growth'">Start Growth Plan</a>
					</div>
					<div class="pricing-card animate-on-scroll hover-lift delay-3">
						<div class="pricing-badge">FULL PARTNERSHIP</div>
						<div class="pricing-price">$1,297<span class="pricing-period">/mo</span></div>
						<div class="pricing-label">Everything You Need</div>
						<ul class="pricing-features">
							<li>✓ Everything in Growth</li>
							<li>✓ SEO & local search optimization</li>
							<li>✓ Competitor monitoring</li>
							<li>✓ Content creation (blog + social)</li>
							<li>✓ Lead generation</li>
							<li>✓ Dedicated account contact</li>
							<li>✓ Everything your business needs online — one team</li>
						</ul>
						<a href="#audit-form" class="btn-secondary" onclick="document.getElementById('scanForm').dataset.tier='partnership'">Start Full Partnership</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Social Proof -->
		<section class="social-proof">
			<div class="container">
				<div class="proof-stats">
					<div class="proof-stat animate-on-scroll delay-1">
						<span class="proof-number">87/100</span>
						<span class="proof-label">Average business health score after 3 months</span>
					</div>
					<div class="proof-stat animate-on-scroll delay-2">
						<span class="proof-number">14 pts</span>
						<span class="proof-label">Average score improvement in first month</span>
					</div>
					<div class="proof-stat animate-on-scroll delay-3">
						<span class="proof-number">3 issues/wk</span>
						<span class="proof-label">Found and fixed automatically every week</span>
					</div>
				</div>
				<div class="testimonials">
					<div class="testimonial animate-on-scroll delay-1">
						<p>"I used to check reviews at 11 PM. Now I wake up and they're already handled. My health score went from 52 to 83 in two months."</p>
						<span class="testimonial-author">— Maria G., Restaurant Owner</span>
					</div>
					<div class="testimonial animate-on-scroll delay-2">
						<p>"Our website was going to crash on Friday. CC3PO fixed it Thursday. I didn't even know until the Monday report."</p>
						<span class="testimonial-author">— James T., HVAC Business Owner</span>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="cta animate-on-scroll">
			<div class="container">
				<h2>While you were reading this, your competitor's website went down.</h2>
				<p>Their customer called you instead. Are you ready?</p>
				<p class="cta-sub">Your business health score is waiting. Find out where you stand — free, in 30 seconds.</p>
				<form class="scan-form scan-form-center" id="scanFormBottom">
					<input type="hidden" name="tier" value="free" />
					<div class="form-row">
						<input type="url" name="url" placeholder="Enter your website URL" required aria-label="Website URL" />
						<input type="email" name="email" placeholder="Your email" required aria-label="Email address" />
						<button type="submit" class="btn-primary">Get Your Free Score →</button>
					</div>
				</form>
			</div>
		</section>

		<Footer />

		<style>
			/* --- Base --- */
			:root {
				--bg-primary: #0a0a12;
				--bg-secondary: #11111f;
				--bg-tertiary: #18182b;
				--bg-card: rgba(255, 255, 255, 0.04);
				--text-primary: #fafafa;
				--text-secondary: #a1a1aa;
				--text-muted: #71717a;
				--border: rgba(255, 255, 255, 0.06);
				--accent: #e94560;
				--accent-hover: #ff5a75;
				--accent-secondary: #6b35ff;
				--grad-hero: linear-gradient(135deg, rgba(10,10,18,0.92) 0%, rgba(17,17,31,0.88) 100%);
				--danger: #ef4444;
				--success: #22c55e;
				--warning: #f59e0b;
			}

			* { margin: 0; padding: 0; box-sizing: border-box; }
			html { scroll-behavior: smooth; }
			body {
				font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
				color: var(--text-primary);
				background: var(--bg-primary);
				line-height: 1.6;
			}
			.container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
			.highlight { color: var(--accent); }
			.section-title { font-size: 2rem; font-weight: 800; text-align: center; margin-bottom: 12px; }

			/* --- Hero --- */
			.hero-video {
				position: absolute; top: 0; left: 0; width: 100%; height: 100%;
				object-fit: cover; z-index: 0; opacity: 0.3;
			}
			.hero {
				background: var(--bg-primary); color: var(--text-primary);
				padding: 100px 0 80px; min-height: 70vh;
				display: flex; align-items: center; position: relative; overflow: hidden;
			}
			.hero-badge {
				display: inline-block; background: rgba(233, 69, 96, 0.15); color: var(--accent);
				padding: 6px 16px; border-radius: 20px; font-size: 0.8rem;
				font-weight: 700; letter-spacing: 0.05em; margin-bottom: 24px;
			}
			.hero h1 {
				font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 800;
				line-height: 1.15; margin-bottom: 20px;
			}
			.hero-sub {
				font-size: 1.2rem; color: var(--text-secondary);
				max-width: 640px; margin-bottom: 40px;
			}
			.hero-stats { display: flex; gap: 40px; margin-bottom: 48px; flex-wrap: wrap; }
			.stat { display: flex; flex-direction: column; }
			.stat-number { font-size: 2rem; font-weight: 800; color: var(--accent); }
			.stat-label { font-size: 0.85rem; color: var(--text-secondary); }

			/* --- Form --- */
			.scan-form { max-width: 720px; }
			.scan-form-center { margin: 0 auto; }
			.form-row { display: flex; gap: 12px; flex-wrap: wrap; }
			.form-row input {
				flex: 1; min-width: 200px; padding: 14px 18px;
				background: var(--bg-secondary); border: 2px solid var(--border);
				border-radius: 10px; font-size: 1rem; font-family: inherit;
				color: var(--text-primary); outline: none; transition: border-color 0.2s;
			}
			.form-row input:focus { border-color: var(--accent); }
			.btn-primary {
				padding: 14px 32px; background: var(--accent); color: var(--text-primary);
				border: none; border-radius: 10px; font-size: 1rem; font-weight: 700;
				cursor: pointer; white-space: nowrap; transition: background 0.2s;
			}
			.btn-primary:hover { background: var(--accent-hover); }
			.btn-secondary {
