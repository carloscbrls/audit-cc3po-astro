---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const SITE_TITLE = 'Free Website Compliance & Performance Scan | CC3PO';
const SITE_DESCRIPTION = 'Free website compliance and performance scanner. Check your site for ADA, WCAG, HIPAA, and SEO issues in 60 seconds. CC3PO Business Scan.';
const canonicalURL = new URL(Astro.url.pathname, 'https://audit.cc3po.com');
const ogImage = 'https://cc3po.com/wp-content/uploads/2026/04/Color-Logo-New.png';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:title" content={SITE_TITLE} />
		<meta property="og:description" content={SITE_DESCRIPTION} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="CC3PO Business Scan" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={SITE_TITLE} />
		<meta name="twitter:description" content={SITE_DESCRIPTION} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Service",
			"name": "CC3PO Free Website Compliance Scan",
			"serviceType": "Website Compliance & Performance Scanner",
			"description": "Free website compliance and performance scanner. Check your site for ADA, WCAG, HIPAA, and SEO issues in 60 seconds.",
			"provider": {
				"@type": "LocalBusiness",
				"name": "CC3PO",
				"telephone": "+1-209-423-6633",
				"email": "info@cc3po.com",
				"url": "https://cc3po.com",
				"address": {
					"@type": "PostalAddress",
					"addressLocality": "Stockton",
					"addressRegion": "CA",
					"addressCountry": "US"
				}
			},
			"areaServed": "US",
			"offers": {
				"@type": "Offer",
				"price": "0",
				"priceCurrency": "USD",
				"description": "Free instant compliance and performance scan"
			}
		})} />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<Header />

		<style>
			:root {
				--bg-primary: #0a0a12;
				--bg-secondary: #11111f;
				--bg-tertiary: #18182b;
				--bg-card: rgba(255, 255, 255, 0.04);
				--text-primary: #fafafa;
				--text-secondary: #a1a1aa;
				--text-muted: #71717a;
				--border: rgba(255, 255, 255, 0.06);
				--accent: #e94560;
				--accent-hover: #ff5a75;
				--accent-secondary: #6b35ff;
				--success: #22c55e;
				--warning: #f59e0b;
			}

			* { margin: 0; padding: 0; box-sizing: border-box; }
			html { scroll-behavior: smooth; }
			body {
				font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
				color: var(--text-primary);
				background: var(--bg-primary);
				line-height: 1.6;
			}
			.container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
			.highlight { color: var(--accent); }

			.skip-link{position:absolute;top:-100px;left:0;background:#0d9488;color:#fff;padding:12px 24px;z-index:10000;font-size:16px;font-weight:600;text-decoration:none;border-radius:0 0 8px 0;transition:top .2s}.skip-link:focus{top:0;outline:3px solid #0d9488;outline-offset:2px}:focus-visible{outline:3px solid #0d9488;outline-offset:2px;border-radius:2px}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}

			@keyframes fadeInUp {
				from { opacity: 0; transform: translateY(30px); }
				to { opacity: 1; transform: translateY(0); }
			}
			@keyframes pulseGlow {
				0%, 100% { box-shadow: 0 0 20px rgba(233, 69, 96, 0.15); }
				50% { box-shadow: 0 0 40px rgba(233, 69, 96, 0.3); }
			}
			@keyframes scanLine {
				0% { top: 0; }
				100% { top: 100%; }
			}

			.animate-on-scroll {
				opacity: 0;
				transform: translateY(30px);
				transition: opacity 0.6s ease, transform 0.6s ease;
			}
			.animate-on-scroll.visible {
				opacity: 1;
				transform: translateY(0);
			}
			.animate-on-scroll.delay-1 { transition-delay: 0.1s; }
			.animate-on-scroll.delay-2 { transition-delay: 0.2s; }
			.animate-on-scroll.delay-3 { transition-delay: 0.3s; }
			.animate-on-scroll.delay-4 { transition-delay: 0.4s; }
			.hover-lift {
				transition: transform 0.25s ease, box-shadow 0.25s ease;
			}
			.hover-lift:hover {
				transform: translateY(-4px);
				box-shadow: 0 8px 30px rgba(233, 69, 96, 0.15);
			}
			@media (prefers-reduced-motion: reduce) {
				.animate-on-scroll { opacity: 1; transform: none; transition: none; }
			}

			/* --- Hero --- */
			.hero {
				padding: 120px 0 80px;
				min-height: 80vh;
				display: flex;
				align-items: center;
				position: relative;
				overflow: hidden;
				background: radial-gradient(ellipse at 20% 50%, rgba(233, 69, 96, 0.08) 0%, transparent 50%),
				            radial-gradient(ellipse at 80% 50%, rgba(107, 53, 255, 0.06) 0%, transparent 50%),
				            var(--bg-primary);
			}
			.hero::before {
				content: '';
				position: absolute;
				top: 0; left: 0; right: 0; bottom: 0;
				background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.02'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
				opacity: 0.5;
				pointer-events: none;
			}
			.hero-content {
				position: relative;
				z-index: 1;
			}
			.hero-badge {
				display: inline-block;
				background: rgba(233, 69, 96, 0.12);
				border: 1px solid rgba(233, 69, 96, 0.25);
				color: var(--accent);
				padding: 8px 20px;
				border-radius: 24px;
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				margin-bottom: 28px;
			}
			.hero h1 {
				font-size: clamp(2.2rem, 5vw, 3.8rem);
				font-weight: 800;
				line-height: 1.1;
				margin-bottom: 24px;
				letter-spacing: -0.02em;
			}
			.hero-sub {
				font-size: 1.25rem;
				color: var(--text-secondary);
				max-width: 600px;
				margin-bottom: 40px;
				line-height: 1.7;
			}

			/* --- Scan Form --- */
			.scan-form {
				background: var(--bg-secondary);
				border: 1px solid var(--border);
				border-radius: 20px;
				padding: 32px;
				max-width: 680px;
				position: relative;
				overflow: hidden;
			}
			.scan-form::after {
				content: '';
				position: absolute;
				top: 0; left: 0; right: 0;
				height: 3px;
				background: linear-gradient(90deg, var(--accent), var(--accent-secondary), var(--accent));
				background-size: 200% 100%;
				animation: scanLine 2s ease-in-out infinite alternate;
			}
			.form-row {
				display: flex;
				gap: 12px;
				flex-wrap: wrap;
			}
			.form-row input {
				flex: 1;
				min-width: 200px;
				padding: 16px 20px;
				background: var(--bg-primary);
				border: 2px solid var(--border);
				border-radius: 12px;
				font-size: 1rem;
				font-family: inherit;
				color: var(--text-primary);
				outline: none;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			.form-row input:focus {
				border-color: var(--accent);
				box-shadow: 0 0 0 3px rgba(233, 69, 96, 0.15);
			}
			.form-row input::placeholder { color: var(--text-muted); }
			.btn-primary {
				padding: 16px 36px;
				background: linear-gradient(135deg, var(--accent), #b5179e);
				color: var(--text-primary);
				border: none;
				border-radius: 12px;
				font-size: 1rem;
				font-weight: 700;
				cursor: pointer;
				white-space: nowrap;
				transition: transform 0.2s, box-shadow 0.2s;
			}
			.btn-primary:hover {
				transform: translateY(-2px);
				box-shadow: 0 8px 24px rgba(233, 69, 96, 0.35);
			}
			.form-note {
				margin-top: 14px;
				font-size: 0.85rem;
				color: var(--text-muted);
			}

			/* --- Stats Bar --- */
			.stats-bar {
				padding: 60px 0;
				background: var(--bg-secondary);
			}
			.stats-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 40px;
				text-align: center;
			}
			.stat-item {}
			.stat-number {
				font-size: clamp(2rem, 4vw, 3rem);
				font-weight: 800;
				color: var(--accent);
				display: block;
				margin-bottom: 8px;
			}
			.stat-label {
				font-size: 1rem;
				color: var(--text-secondary);
				line-height: 1.5;
			}

			/* --- What We Check --- */
			.what-we-check {
				padding: 80px 0;
				background: var(--bg-primary);
			}
			.section-title {
				font-size: clamp(1.8rem, 3vw, 2.5rem);
				font-weight: 800;
				text-align: center;
				margin-bottom: 16px;
			}
			.section-sub {
				text-align: center;
				color: var(--text-secondary);
				max-width: 600px;
				margin: 0 auto 56px;
				font-size: 1.05rem;
			}
			.check-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 24px;
			}
			.check-card {
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: 16px;
				padding: 36px 28px;
				transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
			}
			.check-card:hover {
				transform: translateY(-4px);
				box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
				border-color: rgba(255, 255, 255, 0.12);
			}
			.check-icon {
				width: 56px;
				height: 56px;
				border-radius: 14px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.6rem;
				margin-bottom: 20px;
			}
			.check-card:nth-child(1) .check-icon { background: rgba(233, 69, 96, 0.12); }
			.check-card:nth-child(2) .check-icon { background: rgba(34, 197, 94, 0.12); }
			.check-card:nth-child(3) .check-icon { background: rgba(245, 158, 11, 0.12); }
			.check-card:nth-child(4) .check-icon { background: rgba(107, 53, 255, 0.12); }
			.check-card h3 {
				font-size: 1.2rem;
				font-weight: 700;
				margin-bottom: 10px;
			}
			.check-card p {
				color: var(--text-secondary);
				font-size: 0.95rem;
				line-height: 1.6;
			}
			.check-list {
				list-style: none;
				margin-top: 16px;
			}
			.check-list li {
				padding: 6px 0;
				font-size: 0.9rem;
				color: var(--text-secondary);
				position: relative;
				padding-left: 20px;
			}
			.check-list li::before {
				content: '✓';
				position: absolute;
				left: 0;
				color: var(--success);
				font-weight: 700;
			}

			/* --- How It Works --- */
			.how-it-works {
				padding: 80px 0;
				background: var(--bg-secondary);
			}
			.steps-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 32px;
				position: relative;
			}
			.step-card {
				text-align: center;
				padding: 32px 24px;
			}
			.step-number {
				width: 56px;
				height: 56px;
				border-radius: 50%;
				background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
				color: #fff;
				font-size: 1.4rem;
				font-weight: 800;
				display: flex;
				align-items: center;
				justify-content: center;
				margin: 0 auto 20px;
			}
			.step-card h3 {
				font-size: 1.15rem;
				font-weight: 700;
				margin-bottom: 10px;
			}
			.step-card p {
				color: var(--text-secondary);
				font-size: 0.95rem;
				line-height: 1.6;
			}

			/* --- CTA --- */
			.cta-section {
				padding: 80px 0;
				background: radial-gradient(ellipse at center, rgba(233, 69, 96, 0.08) 0%, transparent 60%),
				            var(--bg-primary);
				text-align: center;
			}
			.cta-section h2 {
				font-size: clamp(1.8rem, 3vw, 2.5rem);
				font-weight: 800;
				margin-bottom: 16px;
			}
			.cta-section p {
				color: var(--text-secondary);
				font-size: 1.1rem;
				margin-bottom: 32px;
				max-width: 560px;
				margin-left: auto;
				margin-right: auto;
			}
			.cta-link {
				display: inline-block;
				padding: 18px 48px;
				background: linear-gradient(135deg, var(--accent), #b5179e);
				color: #fff;
				text-decoration: none;
				border-radius: 14px;
				font-size: 1.15rem;
				font-weight: 700;
				transition: transform 0.2s, box-shadow 0.2s;
			}
			.cta-link:hover {
				transform: translateY(-2px);
				box-shadow: 0 8px 30px rgba(233, 69, 96, 0.35);
			}

			/* --- Responsive --- */
			@media (max-width: 768px) {
				.hero { padding: 100px 0 60px; min-height: auto; }
				.hero h1 { font-size: 2rem; }
				.hero-sub { font-size: 1rem; }
				.scan-form { padding: 24px; }
				.form-row { flex-direction: column; }
				.form-row input { min-width: 100%; }
				.stats-grid { grid-template-columns: 1fr; gap: 32px; }
				.check-grid { grid-template-columns: 1fr; }
				.steps-grid { grid-template-columns: 1fr; gap: 24px; }
				.cta-section { padding: 60px 0; }
			}

			@media (max-width: 480px) {
				.hero { padding: 90px 0 50px; }
				.hero h1 { font-size: 1.7rem; }
				.btn-primary { padding: 14px 24px; font-size: 0.95rem; }
				.scan-form { padding: 20px; }
			}
		</style>

		<!-- Hero Section -->
		<section class="hero" id="main-content">
			<div class="container">
				<div class="hero-content">
					<div class="hero-badge animate-on-scroll">Free Compliance & Performance Scan</div>
					<h1 class="animate-on-scroll delay-1">Is Your Website Costing You <span class="highlight">Customers?</span></h1>
					<p class="hero-sub animate-on-scroll delay-2">Get a free instant scan of your website's compliance, performance, and SEO health. Find hidden issues before they cost you — ADA violations, slow load times, security gaps, and more.</p>
					<form class="scan-form animate-on-scroll delay-3" id="scanForm" data-tier="free">
						<input type="hidden" name="tier" value="free" />
						<div class="form-row">
							<input type="url" name="url" id="urlInput" placeholder="Enter your website URL (e.g., https://yoursite.com)" required aria-label="Website URL to scan" />
							<input type="email" name="email" id="emailInput" placeholder="Your email (for results)" required aria-label="Email address for scan results" />
							<button type="submit" class="btn-primary">Scan My Site →</button>
						</div>
						<p class="form-note" id="formStatus">No credit card required. See your compliance score in 60 seconds.</p>
					</form>
				</div>
			</div>
		</section>

		<!-- Stats Bar -->
		<section class="stats-bar">
			<div class="container">
				<div class="stats-grid">
					<div class="stat-item animate-on-scroll">
						<span class="stat-number">95%</span>
						<span class="stat-label">of small business websites have compliance issues</span>
					</div>
					<div class="stat-item animate-on-scroll delay-1">
						<span class="stat-number">40%</span>
						<span class="stat-label">of visitors leave if your site loads in 3+ seconds</span>
					</div>
					<div class="stat-item animate-on-scroll delay-2">
						<span class="stat-number">$4K+</span>
						<span class="stat-label">per ADA violation — demand letters are rising</span>
					</div>
				</div>
			</div>
		</section>

		<!-- What We Check -->
		<section class="what-we-check" id="what-we-check">
			<div class="container">
				<h2 class="section-title">What We <span class="highlight">Check</span></h2>
				<p class="section-sub">Our scanner analyzes your website across four critical areas that impact your business.</p>
				<div class="check-grid">
					<div class="check-card animate-on-scroll hover-lift">
						<div class="check-icon">🛡️</div>
						<h3>WCAG / ADA Compliance</h3>
						<p>Full accessibility audit against WCAG 2.1 AA standards and ADA requirements.</p>
						<ul class="check-list">
							<li>Color contrast ratios</li>
							<li>Missing alt text on images</li>
							<li>Keyboard navigation gaps</li>
							<li>ARIA label issues</li>
							<li>Form accessibility</li>
						</ul>
					</div>
					<div class="check-card animate-on-scroll delay-1 hover-lift">
						<div class="check-icon">⚡</div>
						<h3>Performance & Speed</h3>
						<p>Core Web Vitals and load time analysis that directly impact your conversion rate.</p>
						<ul class="check-list">
							<li>Page load time</li>
							<li>Largest Contentful Paint</li>
							<li>Cumulative Layout Shift</li>
							<li>First Input Delay</li>
							<li>Mobile performance</li>
						</ul>
					</div>
					<div class="check-card animate-on-scroll delay-2 hover-lift">
						<div class="check-icon">🔍</div>
						<h3>SEO Issues</h3>
						<p>Search engine optimization gaps that are hiding your site from potential customers.</p>
						<ul class="check-list">
							<li>Missing meta descriptions</li>
							<li>Heading structure issues</li>
							<li>Broken links</li>
							<li>Mobile usability</li>
							<li>Schema markup gaps</li>
						</ul>
					</div>
					<div class="check-card animate-on-scroll delay-3 hover-lift">
						<div class="check-icon">🔒</div>
						<h3>Security Gaps</h3>
						<p>Security vulnerabilities that put your business and customer data at risk.</p>
						<ul class="check-list">
							<li>SSL/TLS configuration</li>
							<li>Missing security headers</li>
							<li>Mixed content warnings</li>
							<li>Cookie consent compliance</li>
							<li>Data privacy issues</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- How It Works -->
		<section class="how-it-works">
			<div class="container">
				<h2 class="section-title">How It <span class="highlight">Works</span></h2>
				<p class="section-sub">Get your free scan in three simple steps — no signup required.</p>
				<div class="steps-grid">
					<div class="step-card animate-on-scroll">
						<div class="step-number">1</div>
						<h3>Enter Your URL</h3>
						<p>Type your website address and email. That's it — no account setup, no credit card.</p>
					</div>
					<div class="step-card animate-on-scroll delay-1">
						<div class="step-number">2</div>
						<h3>We Scan Everything</h3>
						<p>Our scanner checks your site for 50+ compliance, performance, SEO, and security issues in 60 seconds.</p>
					</div>
					<div class="step-card animate-on-scroll delay-2">
						<div class="step-number">3</div>
						<h3>Get Your Report</h3>
						<p>Receive a detailed report with your Living Compliance Score, prioritized issues, and fix recommendations.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="cta-section">
			<div class="container">
				<h2>Get Your Free Business Scan</h2>
				<p>Find out if your website has hidden compliance, performance, or security issues — before they cost you.</p>
				<a href="https://audit.cc3po.com" class="cta-link">Start Your Free Scan →</a>
			</div>
		</section>

		<Footer />

		<script is:inline>
		(function() {
			// Form submission — calls real edge scanner
			function handleFormSubmit(form) {
				form.addEventListener('submit', function(e) {
					e.preventDefault();
					var urlInput = form.querySelector('input[name="url"]');
					var emailInput = form.querySelector('input[name="email"]');
					var submitBtn = form.querySelector('button[type="submit"]');
					var statusEl = document.getElementById('formStatus');

					var urlVal = urlInput ? urlInput.value.trim() : '';
					var emailVal = emailInput ? emailInput.value.trim() : '';

					if (!urlVal) { urlInput.focus(); if (statusEl) statusEl.textContent = 'Please enter a website URL.'; return; }
					if (!/^https?:\/\//i.test(urlVal)) urlVal = 'https://' + urlVal;

					if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Scanning...'; }
					if (statusEl) { statusEl.textContent = 'Analyzing your website...'; statusEl.style.color = 'var(--text-secondary)'; }

					// Call the real edge scanner API
					fetch('https://scanner.cc3po.com/api/scan', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ url: urlVal, email: emailVal })
					}).then(function(response) { return response.json(); }).then(function(data) {
						// Store scan data and redirect to results
						sessionStorage.setItem('cc3po_scan_result', JSON.stringify(data));
						window.location.href = '/success?url=' + encodeURIComponent(urlVal) + '&email=' + encodeURIComponent(emailVal) + '&score=' + data.overallScore;
					}).catch(function(err) {
						if (statusEl) { statusEl.textContent = 'Scan failed. Please try again.'; statusEl.style.color = 'var(--accent)'; }
						if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Scan My Site →'; }
					});
				});
			}

			var mainForm = document.getElementById('scanForm');
			if (mainForm) handleFormSubmit(mainForm);

			// Scroll animations
			var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			var observer = new IntersectionObserver(function(entries) {
				entries.forEach(function(entry) {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible');
						observer.unobserve(entry.target);
					}
				});
			}, { rootMargin: '0px 0px -60px 0px', threshold: 0.1 });

			document.querySelectorAll('.animate-on-scroll').forEach(function(el) {
				if (prefersReducedMotion) { el.classList.add('visible'); } else { observer.observe(el); }
			});

			// Nav scroll effect
			var nav = document.querySelector('nav');
			if (nav) {
				window.addEventListener('scroll', function() {
					if (window.scrollY > 20) nav.classList.add('scrolled');
					else nav.classList.remove('scrolled');
				}, { passive: true });
			}
		})();
		</script>
	</body>
</html>